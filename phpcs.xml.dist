<?xml version="1.0"?>
<ruleset name="fast-composer">
    <description>PSR-12, with this codebase's conventions.</description>
    <file>src</file>
    <file>bin/fast-composer</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="s"/>

    <rule ref="PSR12">
        <!-- String concatenation is written without spaces ('a'.$b), like Symfony; every
             other binary operator is still checked by Squiz.WhiteSpace.OperatorSpacing. -->
        <exclude name="PSR12.Operators.OperatorSpacing"/>
        <!-- Log and error messages are long single lines on purpose (grep-able). -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>
    <rule ref="Squiz.WhiteSpace.OperatorSpacing">
        <properties>
            <property name="ignoreNewlines" value="true"/>
        </properties>
    </rule>
</ruleset>
