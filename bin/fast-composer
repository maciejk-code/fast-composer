#!/usr/bin/env php
<?php
// Fast Composer has no runtime dependencies. Load only its own classes instead of the
// surrounding (possibly global) vendor autoloader, so that running the Composer solver
// in-process cannot pick up foreign copies of Composer's own dependencies.
spl_autoload_register(static function (string $class): void {
    if (str_starts_with($class, 'FastComposer\\')) {
        $file = __DIR__.'/../src/'.str_replace('\\', '/', substr($class, strlen('FastComposer\\'))).'.php';
        if (is_file($file)) {
            require $file;
        }
    }
});
exit((new FastComposer\Application())->run(array_slice($argv, 1)));
