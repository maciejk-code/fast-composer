#!/usr/bin/env php
<?php
$autoload = $GLOBALS['_composer_autoload_path'] ?? (__DIR__ . '/../vendor/autoload.php');
if (!is_string($autoload) || !is_file($autoload)) {
    fwrite(STDERR, "fast-composer: Composer autoloader not found\n");
    exit(1);
}
require $autoload;
exit((new FastComposer\Application())->run(array_slice($argv, 1)));
